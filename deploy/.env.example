# ddns tunnel broker — production environment template.
# Copy to `.env` in this directory (deploy/.env) and edit.

# Required — the tunnel apex domain (clients connect to <slug>.<domain>).
DDNS_DOMAIN=tunnel.example.com

# Certificate source — pick EXACTLY ONE:

# 1) Static PEM (recommended): mount fullchain + key at ./certs (read-only).
DDNS_CERT=/certs/fullchain.pem
DDNS_KEY=/certs/privkey.pem

# 2) Let's Encrypt TLS-ALPN-01 (apex only; wildcards need DNS-01 — Phase B).
#    Port 443 must be reachable from the internet; DNS A record for the apex.
# DDNS_ACME_EMAIL=admin@example.com

# 3) Dev self-signed cert — NEVER in production.
# DDNS_DEV=1

# Networking / limits (defaults shown).
# Port 443 is the default so public URLs carry no port (https://<slug>.<domain>).
# Set DDNS_PUBLIC_PORT=8443 only when 443 is taken by another web server.
DDNS_LISTEN=0.0.0.0:443
DDNS_PUBLIC_PORT=443
# DDNS_HTTP_LISTEN=0.0.0.0:80   # plain-HTTP listener: 301 to HTTPS + HTTP-01
# DDNS_STUN_PORT=3478       # WebRTC ICE STUN (P2P data plane)
# DDNS_MAX_SESSIONS=256
# DDNS_MAX_STREAMS_PER_SESSION=512  # hard cap per session, beyond token limits
# DDNS_WATCHDOG_MS=5000
# DDNS_WEB_DIST=/opt/ddns/web/public  # dioxus web bundle dir, served at /_assets/*
# DDNS_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# First-run /setup takeover guard: REQUIRED when DDNS_LISTEN is not loopback.
# Set a random value BEFORE the first start; /setup is locked until it matches.
# DDNS_SETUP_TOKEN=change-me-before-first-run

# --- Optional (read directly from the environment by the broker) ---

# External base URL used in emailed links (verification/reset).
# DDNS_BASE_URL=https://tunnel.example.com


# Redis for rate limiting (Phase C) + the token-balance hot counter.
# Empty/unset → SQLite-only mode: no rate limiting, no fast-path counter.
# Under Compose this defaults to the bundled redis service. To run SQLite-only,
# KEEP the redis service (the broker `depends_on` it) and set the URL empty:
# DDNS_REDIS_URL=
# DDNS_REDIS_URL=redis://redis:6379

# SMTP for verification/reset/alert emails. Absent → dev-mode link logging only.
# DDNS_SMTP_HOST=smtp.example.com
# DDNS_SMTP_PORT=587
# DDNS_SMTP_USER=apikey
# DDNS_SMTP_PASS=...
# DDNS_SMTP_FROM=no-reply@example.com
# DDNS_SMTP_TLS=starttls   # starttls | tls | none

# Optional WireGuard operator/control-plane network. Enable the Compose
# profile with `docker compose --profile wireguard up -d`.
# WG_SERVERURL=203.0.113.10
# WG_SERVERPORT=51821
# WG_PEERS=operator
# WG_INTERNAL_SUBNET=10.13.13.0

# --- DDNS (home deployment with a dynamic public IPv4) ----------------------
# Keeps the apex + wildcard A records in sync via the Porkbun API when the
# WAN IP changes (deploy/ddns-porkbun.sh, systemd timer every 5 min).
# NOTE: does NOT work behind CGNAT — the WAN must be a real public IPv4
# (bridge mode / public-IP package). Porkbun API: https://porkbun.com/account/api
# DDNS_PORKBUN_API_KEY=...
# DDNS_PORKBUN_SECRET=...
# DDNS_PORKBUN_DOMAIN=tunnel.example.com   # default: DDNS_DOMAIN
# DDNS_PORKBUN_HOSTS="tunnel.example.com *.tunnel.example.com"
# DDNS_PORKBUN_TTL=300

# --- Failover (home primary + VPS backup) -----------------------------------
# Home side: push DB snapshot + certs to the VPS every 5 min.
#   DDNS_VPS_SSH=root@203.0.113.10        # ssh/scp target on the backup VPS
#   DDNS_VPS_DEPLOY_DIR=/opt/ddns-deploy  # deploy dir on the VPS
#   DDNS_VOLUME=ddns_broker-data          # broker data volume (verify: docker volume ls)
# VPS side: health-check the home broker; on failure start the stack + flip DNS.
#   DDNS_HOME_IP=203.0.113.7              # home public IPv4
#   DDNS_VPS_IP=203.0.113.10              # this VPS public IPv4
#   DDNS_FAILOVER_CHECKS=3                # consecutive failures before failover
#   DDNS_FAILOVER_INTERVAL=60             # seconds between checks

